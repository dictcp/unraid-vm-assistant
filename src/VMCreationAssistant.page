<script>
if (typeof csrf_token !== 'undefined') document.getElementById('vma-csrf-token').value = csrf_token;
(function(){
  const byId=id=>document.getElementById(id), profile=byId('profile'), username=byId('username');
  function update(){
    const selected=profile.options[profile.selectedIndex], isCustom=profile.value==='custom';
    byId('custom-image-field').hidden=!isCustom;
    byId('summary-image').textContent=selected.textContent.trim();
    byId('summary-user').textContent=username.value||'—';
    byId('summary-compute').textContent=byId('vcpus').value+' CPU · '+(Number(byId('ram_mb').value||0)/1024)+' GiB';
    byId('summary-disk').textContent=byId('disk_gib').value+' GiB';
    byId('summary-network').textContent=byId('bridge').value+' · DHCP';
    byId('vm-path-preview').textContent=byId('domains_dir').value.replace(/\/+$/,'')+'/'+(byId('name').value||'vm-name');
  }
  profile.addEventListener('change',function(){username.value=profile.options[profile.selectedIndex].dataset.user;update();});
  ['name','username','vcpus','ram_mb','disk_gib','bridge','domains_dir'].forEach(id=>byId(id).addEventListener('input',update));
  update();
<?php if ($job && in_array($job['state'], ['queued', 'running'], true)): ?>
  window.setTimeout(()=>window.location.replace('?job=<?= rawurlencode((string)$job['name']) ?>'),3000);
<?php elseif ($message !== '' && $selectedJob !== ''): ?>
  window.setTimeout(()=>window.location.replace('?job=<?= rawurlencode($selectedJob) ?>'),1000);
<?php endif; ?>
})();
</script>
