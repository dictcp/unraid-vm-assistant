<?php
require_once '/usr/local/emhttp/plugins/unraid-vm-assistant-php/lib/VMProvisioner.php';

function vmaEscape(mixed $value): string
{
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function vmaDefaultKeys(): string
{
    foreach (['/root/.ssh/id_ed25519.pub', '/root/.ssh/authorized_keys'] as $path) {
        if (!is_file($path)) {
            continue;
        }
        $keys = [];
        foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
            $line = trim($line);
            if (preg_match('/^(ssh-|ecdsa-|sk-)/', $line)) {
                $keys[] = $line;
            }
        }
        if ($keys !== []) {
            return implode("\n", $keys);
        }
    }
    return '';
}

function vmaJobPaths(string $name): array
{
    $base = VMProvisioner::JOB_ROOT . '/' . $name;
    return [
        'spec' => $base . '.json',
        'log' => $base . '.log',
        'status' => $base . '.status.json',
    ];
}

function vmaReadJob(string $name): ?array
{
    if (!preg_match('/^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$/', $name)) {
        return null;
    }
    $paths = vmaJobPaths($name);
    $status = is_file($paths['status'])
        ? json_decode((string)file_get_contents($paths['status']), true)
        : null;
    if (!is_array($status) && !is_file($paths['log'])) {
        return null;
    }
    return [
        'name' => $name,
        'state' => is_array($status) ? (string)($status['state'] ?? 'queued') : 'queued',
        'error' => is_array($status) ? (string)($status['error'] ?? '') : '',
        'log' => is_file($paths['log']) ? (string)file_get_contents($paths['log']) : '',
    ];
}

function vmaLaunchWorker(array $spec): void
{
    if (!is_dir(VMProvisioner::JOB_ROOT) && !mkdir(VMProvisioner::JOB_ROOT, 0700, true)) {
        throw new RuntimeException('Could not create temporary job directory.');
    }
    chmod(dirname(VMProvisioner::JOB_ROOT), 0700);
    chmod(VMProvisioner::JOB_ROOT, 0700);
    $name = (string)$spec['name'];
    $paths = vmaJobPaths($name);
    foreach ($paths as $path) {
        @unlink($path);
    }
    $json = json_encode($spec, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
    if (file_put_contents($paths['spec'], $json, LOCK_EX) === false || !chmod($paths['spec'], 0600)) {
        throw new RuntimeException('Could not write VM job specification.');
    }
    $worker = '/usr/local/emhttp/plugins/unraid-vm-assistant-php/scripts/create-vm.php';
    $php = '/usr/bin/php';
    $setsid = '/usr/bin/setsid';
    foreach ([$worker, $php, $setsid] as $path) {
        if (!is_file($path) || !is_executable($path)) {
            throw new RuntimeException("Required worker executable is unavailable: {$path}");
        }
    }
    $command = [
        $setsid, '-f', $php, $worker,
        '--spec', $paths['spec'],
        '--log', $paths['log'],
        '--status', $paths['status'],
    ];
    $descriptors = [
        0 => ['file', '/dev/null', 'r'],
        1 => ['file', '/dev/null', 'a'],
        2 => ['file', '/dev/null', 'a'],
    ];
    $process = proc_open($command, $descriptors, $pipes, null, null, ['bypass_shell' => true]);
    if (!is_resource($process)) {
        throw new RuntimeException('Could not launch VM creation worker.');
    }
    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        throw new RuntimeException("VM creation worker launcher exited with code {$exitCode}.");
    }
}

$profiles = VMProvisioner::profiles();
$values = VMProvisioner::normalizeSpec([
    'profile' => 'ubuntu-26.04',
    'name' => '',
    'username' => 'ubuntu',
    'ssh_keys' => vmaDefaultKeys(),
    'ram_mb' => 2048,
    'vcpus' => 2,
    'disk_gib' => 20,
    'bridge' => 'br0',
    'domains_dir' => '/mnt/user/domains',
    'start' => true,
    'autostart' => false,
]);
$errors = [];
$message = '';
$selectedJob = trim((string)($_GET['job'] ?? ''));

if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'create') {
    $values = VMProvisioner::normalizeSpec([
        'profile' => $_POST['profile'] ?? '',
        'image_source' => $_POST['image_source'] ?? '',
        'name' => $_POST['name'] ?? '',
        'username' => $_POST['username'] ?? '',
        'ssh_keys' => $_POST['ssh_keys'] ?? '',
        'ram_mb' => $_POST['ram_mb'] ?? 0,
        'vcpus' => $_POST['vcpus'] ?? 0,
        'disk_gib' => $_POST['disk_gib'] ?? 0,
        'bridge' => $_POST['bridge'] ?? '',
        'domains_dir' => $_POST['domains_dir'] ?? '',
        'start' => true,
        'autostart' => isset($_POST['autostart']),
    ]);
    $errors = VMProvisioner::validateSpec($values);
    if ($errors === []) {
        try {
            vmaLaunchWorker($values);
            $selectedJob = (string)$values['name'];
            $message = 'VM creation queued. The first image download can take several minutes; subsequent VMs reuse the cache.';
        } catch (Throwable $error) {
            $errors[] = $error->getMessage();
        }
    }
}

$job = $selectedJob !== '' ? vmaReadJob($selectedJob) : null;
$jobState = $job['state'] ?? '';
$jobClass = $jobState === 'complete' ? 'is-complete' : ($jobState === 'failed' ? 'is-failed' : 'is-running');
?>
