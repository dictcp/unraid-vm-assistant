ay:block;margin-top:3px;opacity:.65;font-size:11px;line-height:1.35}.vma-create{width:100%;margin-top:8px;padding:11px 14px;border:0;border-radius:7px;background:#ff8c2a;color:#fff;font-weight:800;cursor:pointer}.vma-create:hover{background:#ed7917}.vma-note{margin:14px 0 0;padding-top:13px;border-top:1px solid rgba(127,127,127,.2);opacity:.65;font-size:11px;line-height:1.45}.vma-alert{margin-bottom:15px;padding:12px 14px;border-radius:7px;white-space:pre-wrap}.vma-error{background:#fde8e8;color:#8b1e1e}.vma-message{background:#e8f5ea;color:#1f6c2d}.vma-job{margin-top:18px}.vma-log{max-height:340px;overflow:auto;margin-top:12px;padding:14px;border-radius:7px;background:#151a20;color:#dbe4ee;white-space:pre-wrap;font:12px/1.55 monospace}.vma-state{display:inline-block;margin-left:8px;padding:3px 8px;border-radius:999px;font-size:11px}.is-running .vma-state{background:#fff2d9;color:#8a5700}.is-complete .vma-state{background:#dff4e4;color:#166529}.is-failed .vma-state{background:#fde0e0;color:#8b1e1e}.vma-custom[hidden]{display:none}@media(prefers-color-scheme:dark){.vma-shell input[type=text],.vma-shell input[type=number],.vma-shell select,.vma-shell textarea{--input-bg:#20252b}}@media(max-width:860px){.vma-layout{grid-template-columns:1fr}.vma-summary{position:static}}@media(max-width:560px){.vma-grid,.vma-three{grid-template-columns:1fr}.vma-hero{display:block}.vma-badge{display:inline-block;margin-top:15px}}
