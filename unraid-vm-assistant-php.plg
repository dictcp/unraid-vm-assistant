<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN
  name="unraid-vm-assistant-php"
  author="dictcp"
  version="2026.08.31.1"
  launch="Settings/VMCreationAssistant"
  pluginURL="https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/main/unraid-vm-assistant-php.plg"
  support="https://github.com/dictcp/unraid-vm-assistant"
  min="7.3.0"
>

<CHANGES>
<![CDATA[
### 2026.08.31.1
- Installs normal repository files directly from the matching immutable Git tag.
- Keeps vm.sh as a standalone source file and delegates provisioning to its installed copy.
- Supports Ubuntu 26.04/24.04, Debian 13, Fedora 43, and custom qcow2 images.
- Creates cloud-init users, installs SSH keys and qemu-guest-agent, then registers the VM in Unraid.
- Runs on Unraid's PHP and native virtualization/filesystem commands without Docker or virt-install.
- Adds a Create Cloud VM button beside Add VM in Unraid VM Manager.
]]>
</CHANGES>

<FILE Name="/tmp/unraid-vm-assistant-php/2026.08.31.1/src/scripts/vm.sh">
<URL>https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/2026.08.31.1/src/scripts/vm.sh</URL>
</FILE>
<FILE Name="/tmp/unraid-vm-assistant-php/2026.08.31.1/src/VMCreationAssistant.page">
<URL>https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/2026.08.31.1/src/VMCreationAssistant.page</URL>
</FILE>
<FILE Name="/tmp/unraid-vm-assistant-php/2026.08.31.1/src/VMManagerIntegration.page">
<URL>https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/2026.08.31.1/src/VMManagerIntegration.page</URL>
</FILE>
<FILE Name="/tmp/unraid-vm-assistant-php/2026.08.31.1/src/lib/VMProvisioner.php">
<URL>https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/2026.08.31.1/src/lib/VMProvisioner.php</URL>
</FILE>
<FILE Name="/tmp/unraid-vm-assistant-php/2026.08.31.1/src/scripts/create-vm.php">
<URL>https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/2026.08.31.1/src/scripts/create-vm.php</URL>
</FILE>
<FILE Name="/tmp/unraid-vm-assistant-php/2026.08.31.1/README.md">
<URL>https://raw.githubusercontent.com/dictcp/unraid-vm-assistant/2026.08.31.1/README.md</URL>
</FILE>
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PLUGIN_NAME="unraid-vm-assistant-php"
PLUGIN_DIR="/boot/config/plugins/${PLUGIN_NAME}"
STAGE_DIR="/tmp/unraid-vm-assistant-php/2026.08.31.1"

if [ ! -d /boot/config/plugins ]; then
  echo "ERROR: This plugin must be installed on Unraid." >&2
  exit 1
fi

for command in php virsh qemu-img jq curl truncate mkfs.vfat mcopy blkid mount umount setsid install; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "ERROR: Required Unraid command is missing: ${command}" >&2
    exit 1
  fi
done

mkdir -p "${PLUGIN_DIR}"
chmod 700 "${PLUGIN_DIR}"

mkdir -p '/usr/local/emhttp/plugins/unraid-vm-assistant-php/scripts'
mkdir -p '/usr/local/emhttp/plugins/unraid-vm-assistant-php'
mkdir -p '/usr/local/emhttp/plugins/unraid-vm-assistant-php/lib'
install -m 0755 '/tmp/unraid-vm-assistant-php/2026.08.31.1/src/scripts/vm.sh' '/usr/local/emhttp/plugins/unraid-vm-assistant-php/scripts/vm.sh'
install -m 0644 '/tmp/unraid-vm-assistant-php/2026.08.31.1/src/VMCreationAssistant.page' '/usr/local/emhttp/plugins/unraid-vm-assistant-php/VMCreationAssistant.page'
install -m 0644 '/tmp/unraid-vm-assistant-php/2026.08.31.1/src/VMManagerIntegration.page' '/usr/local/emhttp/plugins/unraid-vm-assistant-php/VMManagerIntegration.page'
install -m 0644 '/tmp/unraid-vm-assistant-php/2026.08.31.1/src/lib/VMProvisioner.php' '/usr/local/emhttp/plugins/unraid-vm-assistant-php/lib/VMProvisioner.php'
install -m 0755 '/tmp/unraid-vm-assistant-php/2026.08.31.1/src/scripts/create-vm.php' '/usr/local/emhttp/plugins/unraid-vm-assistant-php/scripts/create-vm.php'
install -m 0644 '/tmp/unraid-vm-assistant-php/2026.08.31.1/README.md' '/usr/local/emhttp/plugins/unraid-vm-assistant-php/README.md'

rm -rf "${STAGE_DIR}"
echo "VM Creation Assistant installed under Settings -> User Utilities."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
set -euo pipefail

rm -rf /usr/local/emhttp/plugins/unraid-vm-assistant-php
rm -rf /tmp/unraid-vm-assistant-php
rm -rf /tmp/unraid-vm-assistant
rm -rf /boot/config/plugins/unraid-vm-assistant-php
echo "VM Creation Assistant removed. Existing VMs and /mnt image caches were preserved."
]]>
</INLINE>
</FILE>

</PLUGIN>